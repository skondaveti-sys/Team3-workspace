<%- include('partials/header', { title: 'Plan a route', active: 'addresses' }) %>

  <main id="main" class="mx-auto max-w-3xl px-4 py-8 sm:py-12">
    <h1 class="text-2xl font-bold text-slate-900 sm:text-3xl">Plan a route</h1>
    <p class="mt-2 text-slate-600">Enter where you are starting and where you want to go.</p>

    <form id="address-form" method="POST" action="/addresses"
          class="mt-6 rounded-xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="field">
          <label for="startAddress" class="block text-sm font-medium text-slate-700">Start address</label>
          <input
            type="text"
            id="startAddress"
            name="startAddress"
            autocomplete="street-address"
            aria-required="true"
            placeholder="e.g. 120 Main St"
            class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm placeholder:text-slate-400 focus:border-brand-600 focus:ring-2 focus:ring-brand-100 focus:outline-none"
            value="<%= locals.form ? form.startAddress : '' %>">
        </div>

        <div class="field">
          <label for="endAddress" class="block text-sm font-medium text-slate-700">Destination address</label>
          <input
            type="text"
            id="endAddress"
            name="endAddress"
            autocomplete="off"
            aria-required="true"
            placeholder="e.g. Central Library"
            class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm placeholder:text-slate-400 focus:border-brand-600 focus:ring-2 focus:ring-brand-100 focus:outline-none"
            value="<%= locals.form ? form.endAddress : '' %>">
        </div>
      </div>

      <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div id="message" role="status" aria-live="polite" class="text-sm">
          <% if (locals.error) { %>
            <p class="rounded-md bg-red-50 px-3 py-2 text-red-700"><%= error %></p>
          <% } %>
        </div>
        <button type="submit"
                class="w-full rounded-md bg-brand-600 px-5 py-2.5 font-semibold text-white shadow-sm hover:bg-brand-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 sm:w-auto">
          Find route
        </button>
      </div>
    </form>

    <% if (locals.result) { %>
      <section id="result" aria-labelledby="result-heading"
               class="mt-6 rounded-xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
        <h2 id="result-heading" class="text-lg font-semibold text-slate-900">Your route</h2>
        <p class="mt-1 text-slate-600">From <strong class="text-slate-900"><%= result.start %></strong> to <strong class="text-slate-900"><%= result.end %></strong></p>
        <% if (Array.isArray(result.steps) && result.steps.length) { %>
          <ol class="mt-4 list-decimal space-y-1 pl-5">
            <% result.steps.forEach(function (step) { %>
              <li><%= step %></li>
            <% }) %>
          </ol>
        <% } %>
      </section>
    <% } %>
  </main>
</body>
</html>