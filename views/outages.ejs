<%- include('partials/header', { title, active: 'outages' }) %>

  <main id="main" class="mx-auto max-w-5xl px-4 py-8 sm:py-12">
    <h1 class="text-2xl font-bold text-slate-900 sm:text-3xl">Report an outage</h1>
    <p class="mt-2 text-slate-600">Let other riders know when an elevator, escalator or platform is out of service.</p>

    <div class="mt-6 grid gap-6 lg:grid-cols-5 lg:items-start">
      <form id="outage-form"
            hx-post="/outages"
            hx-target="#outages"
            hx-swap="beforeend"
            hx-on::after-request="if (event.detail.successful) { this.reset(); document.querySelector('#form-message').textContent = 'Outage reported.'; }"
            hx-on::response-error="document.querySelector('#form-message').textContent = 'Your report was not saved.'"
            class="space-y-4 rounded-xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6 lg:sticky lg:top-6 lg:col-span-2">
        <div>
          <label for="station" class="block text-sm font-medium text-slate-700">Station</label>
          <input id="station" name="station" type="text" placeholder="e.g. Downtown Station"
                 class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm placeholder:text-slate-400 focus:border-brand-600 focus:ring-2 focus:ring-brand-100 focus:outline-none">
        </div>

        <div>
          <label for="description" class="block text-sm font-medium text-slate-700">What is not working?</label>
          <input id="description" name="description" type="text" placeholder="e.g. Elevator to platform B is out"
                 class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm placeholder:text-slate-400 focus:border-brand-600 focus:ring-2 focus:ring-brand-100 focus:outline-none">
        </div>

        <button type="submit"
                class="w-full rounded-md bg-brand-600 px-5 py-2.5 font-semibold text-white shadow-sm hover:bg-brand-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600">
          Report outage
        </button>
        <p id="form-message" role="status" aria-live="polite" class="min-h-5 text-sm font-medium text-slate-700"></p>
      </form>

      <section aria-labelledby="outages-heading" class="lg:col-span-3">
        <h2 id="outages-heading" class="text-lg font-semibold text-slate-900">Reported outages</h2>
        <ul id="outages" class="mt-3 space-y-3">
          <% outages.forEach((outage) => { %>
            <%- include('partials/outage-item', { outage }) %>
          <% }); %>
        </ul>
      </section>
    </div>
  </main>
</body>
</html>