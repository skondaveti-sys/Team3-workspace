<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %></title>
    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
  </head>
  <body>
    <main>
      <h1>Report an outage</h1>

      <form id="outage-form"
            hx-post="/outages"
            hx-target="#outages"
            hx-swap="beforeend"
            hx-on::after-request="if (event.detail.successful) { this.reset(); document.querySelector('#form-message').textContent = 'Outage reported.'; }"
            hx-on::response-error="document.querySelector('#form-message').textContent = 'Your report was not saved.'">
        <label for="station">Station</label>
        <input id="station" name="station" type="text">

        <label for="description">What is not working?</label>
        <input id="description" name="description" type="text">

        <button type="submit">Report outage</button>
        <p id="form-message" role="status" aria-live="polite"></p>
      </form>

      <h2>Reported outages</h2>
      <ul id="outages">
        <% outages.forEach((outage) => { %>
          <%- include('partials/outage-item', { outage }) %>
        <% }); %>
      </ul>
    </main>
  </body>
</html>